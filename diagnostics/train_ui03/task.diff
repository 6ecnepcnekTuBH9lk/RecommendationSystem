+    assert all(set(event) == {'stage', 'epoch', 'ndcg', 'recall', 'device'} for event in points)
+    assert points[-1]['ndcg'] == result['metrics']['overall']['10']['ndcg']
+    assert points[-1]['recall'] == result['metrics']['overall']['10']['recall']
